{
  "name": "myfashion",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"worker,web\" -c \"cyan,magenta\" \"npm run dev --workspace=worker\" \"npm run dev --workspace=web\"",
    "dev:web": "npm run dev --workspace=web",
    "dev:worker": "npm run dev --workspace=worker",
    "dev:dashboard": "npm run dev --workspace=dashboard",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:ping": "npx tsx scripts/test-ping.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "tsx": "^4.19.0"
  }
}
